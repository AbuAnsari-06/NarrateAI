{
  "manifest_version": 3,
  "name": "NarrateAI",
  "version": "1.0.0",
  "description": "Highlight text on any webpage and narrate it with NarrateAI.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NarrateAI",
    "default_popup": "popup.html"
  }
}
